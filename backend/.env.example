# Namma Suvidha backend configuration. Copy to .env and edit. NEVER commit .env.

# Application display name (returned by /api/v1/health)
APP_NAME=Namma Suvidha API
# development | production
APP_ENV=development
# Base path for all versioned endpoints
API_V1_PREFIX=/api/v1
# Host/port uvicorn binds to (used by scripts/docs)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLAlchemy URL (psycopg 3 driver). Supports Supabase Supavisor pooler or local Postgres.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:NEW_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Supabase project URL (Phase 1, owner: Shabaz)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase public anon key (Phase 1, owner: Shabaz)
SUPABASE_ANON_KEY=YOUR_ROTATED_ANON_KEY
# Supabase service-role key - server only, highly sensitive (Phase 1, owner: Shabaz)
SUPABASE_SERVICE_ROLE_KEY=YOUR_ROTATED_SERVICE_ROLE_KEY
# Supabase JWT secret for token verification (Phase 1, owner: Shabaz)
SUPABASE_JWT_SECRET=
# Gemini API key (Phase 1+, owner: Shubham)
GEMINI_API_KEY=

# ---- OpenRouter AI & Voice Feedback Pipeline ----
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_API_KEY_VL=YOUR_OPENROUTER_VL_KEY
OPENROUTER_API_KEY_ULTRA=YOUR_OPENROUTER_ULTRA_KEY
OPENROUTER_API_KEY_LIGHTNING=YOUR_OPENROUTER_LIGHTNING_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AUDIO_TRANSCRIPTION_MODEL=deepgram/nova-3
COMPLAINT_ANALYSIS_MODEL=google/gemini-3.8-flash
OPENROUTER_MULTIMODAL_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FAST_EXTRACTION_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_TIMEOUT_SECONDS=30.0
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=0.5
OPENROUTER_ALLOW_FREE_MODEL_SENSITIVE_DATA=false
VOICE_MAX_AUDIO_BYTES=10485760
IMAGE_MAX_BYTES=10485760

# ---- Groq Speech-to-Text ----
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_PRIMARY_MODEL=whisper-large-v3-turbo
GROQ_STT_FALLBACK_MODEL=whisper-large-v3
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2
GROQ_RETRY_BACKOFF_SECONDS=0.5

# ---- AI Provider Routing (preserved defaults until benchmark review) ----
AI_STT_PROVIDER=openrouter
AI_COMPLAINT_MODEL_TIER=legacy
AI_EMAIL_DRAFT_MODEL_TIER=reasoning
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Government Monitoring module (GOV_*, owner: Ibrahim) ----
# memory | sql (defaults to memory until Shubham's ORM models are merged)
GOV_REPOSITORY_BACKEND=memory
# Comma-separated roles permitted to access /api/v1/government/*
GOV_ALLOWED_ROLES=government,admin
# Development-only auth bypass (forbidden when APP_ENV != development)
GOV_DEV_AUTH_BYPASS=false
# Enable hidden POST /api/v1/government/_dev/load-fixtures in development
GOV_DEV_FIXTURES_ENABLED=false
# Maximum page_size on government paginated endpoints
GOV_MAX_PAGE_SIZE=100
# Condition band thresholds consuming Shubham's official score
GOV_SCORE_RECOMMENDED_MIN=70.0
GOV_SCORE_ATTENTION_MAX=40.0
# Reporting window thresholds in days (independent of Shubham's 45-day evaluator cooldown)
GOV_INSPECTION_STALE_DAYS=45
GOV_RECENT_INSPECTION_DAYS=7
GOV_PENDING_FEEDBACK_WINDOW_DAYS=30
# Repeated complaint cluster thresholds
GOV_REPEAT_WINDOW_DAYS=14
GOV_REPEAT_MIN_COUNT=3
GOV_REPEAT_MIN_REPORTERS=2
# Feedback-driven cleaning thresholds
GOV_CLEAN_WINDOW_MINUTES=60
GOV_CLEAN_MIN_RESPONSES=3
GOV_CLEAN_NEGATIVE_RATIO=0.5
GOV_CLEAN_ESCALATE_AFTER_WINDOWS=1
GOV_CLEAN_LOW_USAGE_HOURS=24
GOV_CLEAN_AUTO_NOTIFY=true
# Notification email provider: test (default, logs [TEST EMAIL — NOT DELIVERED]) | smtp (reserved)
GOV_EMAIL_PROVIDER=test

# ---- Evaluator Authentication & Management module (EVAL_*, owner: Ibrahim) ----
# memory (development/tests only) | sql (mandatory in production; fails closed if unavailable)
EVAL_REPOSITORY_BACKEND=memory
EVAL_WEBAUTHN_RP_ID=localhost
EVAL_WEBAUTHN_RP_NAME=Namma Suvidha Evaluator
EVAL_WEBAUTHN_EXPECTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EVAL_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
EVAL_ID_STORAGE_BUCKET=evaluator-ids
EVAL_EVIDENCE_STORAGE_BUCKET=inspection-evidence
EVAL_ID_MAX_BYTES=5242880
EVAL_ID_SIGNED_URL_TTL_SECONDS=60
EVAL_ID_RETENTION_DAYS_AFTER_DECISION=7
EVAL_MAX_PAGE_SIZE=100

# ---- Evaluator policy reference settings (EVAL_POLICY_*, optional) ----
# Reference configuration only; 45-day cooldown & allocation owned by Shubham
EVAL_POLICY_MAX_DAILY_INSPECTIONS_PER_EVALUATOR=
EVAL_POLICY_RISK_BASED_REINSPECTION_ENABLED=
