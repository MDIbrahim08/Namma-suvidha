# Namma Suvidha frontend configuration. Copy to .env. NEVER commit .env.
# Backend origin (no trailing slash, without /api/v1). REQUIRED.
VITE_API_BASE_URL=http://localhost:8000
# Display name shown in the header
VITE_APP_NAME=Namma Suvidha
# Supabase (Phase 1, owner: Shabaz) - public anon key only, never the service-role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

